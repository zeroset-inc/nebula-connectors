      "const": "full_name"
     },
     "per_page": {
      "const": "100"
     },
     "page": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,3}$"
     }
    },
    "required": [
     "sort",
     "per_page",
     "page"
    ],
    "additionalProperties": false
   },
   "query": {
    "sort": "sort",
    "per_page": "per_page",
    "page": "page"
   },
   "headers": {
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28"
   },
   "credential": "bearer",
   "max_response_bytes": 2097152,
   "timeout_seconds": 15,
   "quotas": [
    {
     "namespace": "github",
     "scope": "account",
     "name": "requests",
     "cost": 1,
     "capacity": 5000,
     "window_seconds": 3600,
     "concurrency": 4
    }
   ]
  }
 ]
}
