{
 "version": 1,
 "provider": "github",
 "revision": "github-inventory-v1",
 "operations": [
  {
   "id": "user.get",
   "caller": "runner",
   "method": "GET",
   "host": "api.github.com",
   "path": "/user",
   "arguments": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
   },
   "query": {},
   "headers": {
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28"
   },
   "credential": "bearer",
   "max_response_bytes": 65536,
   "timeout_seconds": 30,
   "quotas": [
    {
     "namespace": "github",
     "scope": "account",
     "name": "requests",
     "cost": 1,
     "capacity": 5000,
     "window_seconds": 3600,
     "concurrency": 4
    }
   ]
  },
  {
   "id": "repos.get",
   "caller": "runner",
   "method": "GET",
   "host": "api.github.com",
   "path": "/repos/{owner}/{repo}",
   "arguments": {
    "type": "object",
    "properties": {
     "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,39}$"
     },
     "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}$"
     }
    },
    "required": [
     "owner",
     "repo"
    ],
    "additionalProperties": false
   },
   "query": {},
   "headers": {
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28"
   },
   "credential": "bearer",
   "max_response_bytes": 65536,
   "timeout_seconds": 30,
   "quotas": [
    {
     "namespace": "github",
     "scope": "account",
     "name": "requests",
     "cost": 1,
     "capacity": 5000,
     "window_seconds": 3600,
     "concurrency": 4
    }
   ],
   "container_template": "{owner}/{repo}",
   "resource_arguments": [
    "owner",
    "repo"
   ]
  },
  {
   "id": "issues.list",
   "caller": "runner",
   "method": "GET",
   "host": "api.github.com",
   "path": "/repos/{owner}/{repo}/issues",
   "arguments": {
    "type": "object",
    "properties": {
     "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,39}$"
     },
     "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}$"
     },
     "state": {
      "const": "all"
     },
     "sort": {
      "const": "created"
     },
     "direction": {
      "const": "asc"
     },
     "per_page": {
      "const": "4"
     },
     "page": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,5}$"
     }
    },
    "required": [
     "owner",
     "repo",
     "state",
     "sort",
     "direction",
     "per_page",
     "page"
    ],
    "additionalProperties": false
   },
   "query": {
    "state": "state",
    "sort": "sort",
    "direction": "direction",
    "per_page": "per_page",
    "page": "page"
   },
   "headers": {
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28"
   },
   "credential": "bearer",
   "max_response_bytes": 1048576,
   "timeout_seconds": 30,
   "quotas": [
    {
     "namespace": "github",
     "scope": "account",
     "name": "requests",
     "cost": 1,
     "capacity": 5000,
     "window_seconds": 3600,
     "concurrency": 4
    }
   ],
   "container_template": "{owner}/{repo}",
   "resource_arguments": [
    "owner",
    "repo"
   ]
  },
  {
   "id": "issues.comments",
   "caller": "runner",
   "method": "GET",
   "host": "api.github.com",
   "path": "/repos/{owner}/{repo}/issues/{number}/comments",
   "arguments": {
    "type": "object",
    "properties": {
     "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{1,39}$"
     },
     "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}$"
     },
     "number": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,9}$"
     },
     "per_page": {
      "const": "20"
     }
    },
    "required": [
     "owner",
     "repo",
     "number",
     "per_page"
    ],
    "additionalProperties": false
   },
   "query": {
    "per_page": "per_page"
   },
   "headers": {
    "Accept": "application/vnd.github+json",
    "X-GitHub-Api-Version": "2022-11-28"
   },
   "credential": "bearer",
   "max_response_bytes": 2097152,
   "timeout_seconds": 30,
   "quotas": [
    {
     "namespace": "github",
     "scope": "account",
     "name": "requests",
     "cost": 1,
     "capacity": 5000,
     "window_seconds": 3600,
     "concurrency": 4
    }
   ],
   "container_template": "{owner}/{repo}",
   "resource_arguments": [
    "owner",
    "repo",
    "number"
   ]
  },
  {
   "id": "setup.repos.list",
   "caller": "control",
   "method": "GET",
   "host": "api.github.com",
   "path": "/user/repos",
   "arguments": {
    "type": "object",
    "properties": {
